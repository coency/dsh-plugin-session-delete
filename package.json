{
  "name": "dsh-session-delete",
  "version": "0.2.2",
  "description": "DeepSeek Harness (DSH) 的会话删除插件：侧栏会话行的「删除会话…」入口，先经官方写链摘除注册表引用、再删除存储文件，不可恢复。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "bundle",
    "session",
    "delete"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/core.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
